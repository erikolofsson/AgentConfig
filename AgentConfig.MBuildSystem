// Copyright © Erik Olofsson
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

Import "Malterlib/Core/Malterlib.MHeader"

Property
{
	ProductCompanyUniqueIdentifier "info.olofsson"
	{
		!!ProductCompanyUniqueIdentifier undefined
	}

	ProductCompany "Erik Olofsson"
	{
		!!ProductCompany undefined
	}

	MalterlibThread_LinuxUseStaticThreadLocal true
	{
		!!MalterlibThread_LinuxUseStaticThreadLocal undefined
	}

	Malterlib_AssumeMalterlibHost true
	{
		!!Malterlib_AssumeMalterlibHost undefined
	}
}

Repository
{
	!!Repository.Type "Root"

	MalterlibRepoReusePaths =+ [".vscode/*.json"]

	// The files copied from Malterlib keep the copyright of Unbroken AB, and AGENTS.md is generated from CLAUDE.md and the
	// Malterlib documentation it includes. The last matching REUSE annotation wins, so AGENTS.md comes after *.md.
	License {
		Header: ["Copyright © Erik Olofsson", "SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception"]
		, Include: ["*"]
		, Exclude: ["LICENSE", "LICENSES/*", "REUSE.toml"]
		, Disallowed: ["LICENSE.Malterlib", "PROVENANCE.md"]
		, HeaderOverrides: [
			{
				Path: ["mib", ".lldbinit", ".clangd", ".clang-tidy", "*/.clang-tidy", ".editorconfig", ".malterlib-format"]
				, Header: ["Copyright © Unbroken AB", "SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception"]
			}
		]
		, CommentStyles: [
			{
				Path: ["mib"]
				, LinePrefix: "# "
				, DetectShebang: true
			}, {
				Path: [".lldbinit", ".clangd", ".clang-tidy", "*/.clang-tidy", ".editorconfig", ".malterlib-format"]
				, LinePrefix: "# "
			}
		]
		, LicenseFiles: {
			"LICENSES/Apache-2.0.txt": "Malterlib/Core/LICENSES/Apache-2.0.txt"->MakeAbsolute()
			, "LICENSES/LLVM-exception.txt": "Malterlib/Core/LICENSES/LLVM-exception.txt"->MakeAbsolute()
		}
		, ReuseAnnotations: [
			{
				Path: Repository.MalterlibRepoReusePaths
				, CopyrightText: "Erik Olofsson"
				, LicenseIdentifier: "Apache-2.0 WITH LLVM-exception"
				, Precedence: "override"
			}, {
				Path: ["AGENTS.md"]
				, CopyrightText: "Unbroken AB and Erik Olofsson"
				, LicenseIdentifier: "Apache-2.0 WITH LLVM-exception"
				, Precedence: "override"
			}
		]
	}

	CheckLicense true
	{
		!!Repository.CheckLicense undefined
	}

	// Adapted from the policy of the Malterlib repositories, for a public repository that takes issues and pull requests.
	// The rulesets keep master from being deleted or force pushed, with no bypass, so they hold for the owner too. A
	// pull request rule would stop the owner pushing to master directly, unless the owner could bypass it, and then it
	// would not hold for the merges the owner makes. Pull requests merge by rebase, and Actions stay off, so pull
	// requests from forks run nothing. GitHub lists the owner as a collaborator, so the permissions name the owner to
	// keep RemoveOther from removing it.
	Policy {
		RepositorySettings: {
			Name: `@(Repository.URL->GetPath()->GetFile())/@(Repository.URL->GetFileNoExt())`
			, DefaultBranch: "master"
			, IsPrivate: false
			, HasIssues: true
			, HasProjects: false
			, HasWiki: false
			, HasDiscussions: false
			, HasDownloads: false
			, AllowSquashMerge: false
			, AllowMergeCommit: false
			, AllowRebaseMerge: true
			, AllowAutoMerge: false
			, AllowUpdateBranch: false
			, DeleteBranchOnMerge: true
			, Security_SecretScanning: true
			, Security_SecretScanningPushProtection: true
		}
		, Permissions: {
			Users: {"erikolofsson": "admin"}
			, RemoveOther: true
		}
		, GenericRules: {
			"Linear history": {
				Target: "Branch"
				, IncludeRefNames: ["~ALL"]
				, BypassActors: []
				, Rules: [{Type: "LinearHistory"}]
				, Enforcement: "Active"
			}
			, "Protect master": {
				Target: "Branch"
				, IncludeRefNames: ["~DEFAULT_BRANCH"]
				, BypassActors: []
				, Rules: [{Type: "Deletion"}, {Type: "FastForwardOnly"}]
				, Enforcement: "Active"
			}
		}
		, ActionsSettings: {
			ActionsEnabled: false
		}
	}
	{
		!!Repository.Policy undefined
	}

	ApplyPolicy true
	{
		!!Repository.ApplyPolicy undefined
	}
}

Import "AgentConfig.MHeader"
